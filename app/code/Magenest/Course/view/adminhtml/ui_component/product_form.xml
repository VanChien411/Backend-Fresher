<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <fieldset name="reference_materials">
        <argument name="data" xsi:type="array">
            <item name="config" xsi:type="array">
                <item name="label" xsi:type="string" translate="true">Reference Materials</item>
                <item name="collapsible" xsi:type="boolean">true</item>
                <item name="sortOrder" xsi:type="number">5</item>
            </item>
        </argument>

        <field name="reference_rows">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="formElement" xsi:type="string">dynamicRows</item>
                    <item name="component" xsi:type="string">Magento_Ui/js/dynamic-rows/dynamic-rows</item>
                    <item name="label" xsi:type="string">Tài liệu tham khảo</item>
                    <item name="sortOrder" xsi:type="number">100</item>
                    <item name="dataScope" xsi:type="string">reference_rows</item>
                    <item name="addButtonLabel" xsi:type="string">Thêm tài liệu</item>
                    <item name="columnsHeader" xsi:type="boolean">true</item>
                    <item name="componentType" xsi:type="string">dynamicRows</item>
                    <item name="deleteProperty" xsi:type="boolean">true</item>
                    <item name="enableLabel" xsi:type="boolean">true</item>
                    <item name="recordTemplate" xsi:type="string">record</item>
                </item>
            </argument>
        </field>
    </fieldset>
</form>
